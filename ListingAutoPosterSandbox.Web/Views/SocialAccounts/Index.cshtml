@model IReadOnlyList<ListingAutoPosterSandbox.Web.Models.SocialAccount>

@{
    ViewData["Title"] = "Social Accounts";

    var connectedCount = Model.Count(account => account.IsConnected);
    var disconnectedCount = Model.Count(account => !account.IsConnected);
}

<div class="yatco-page-shell">
    <section class="yatco-social-hero">
        <div>
            <p class="yatco-eyebrow">Connection Center</p>
            <h1>Social Accounts</h1>
            <p>
                Connect and review the social accounts used by the scheduling workflow.
                For the current sandbox, Facebook Page publishing is the active real platform integration.
            </p>
        </div>

        <div class="yatco-social-hero-action">
            <a asp-controller="FacebookOAuth"
               asp-action="Connect"
               class="btn yatco-connect-button yatco-connect-button-large">
                Connect Facebook Page
            </a>

            <p>
                Starts the Facebook OAuth flow and stores the local sandbox token reference.
            </p>
        </div>
    </section>

    @if (TempData["Success"] is string success)
    {
        <div class="yatco-alert yatco-alert-success" role="alert">
            @success
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="yatco-alert yatco-alert-error" role="alert">
            @error
        </div>
    }

    <section class="yatco-social-summary-grid">
        <div class="yatco-stat-card">
            <span>Connected</span>
            <strong>@connectedCount</strong>
        </div>

        <div class="yatco-stat-card">
            <span>Disconnected</span>
            <strong>@disconnectedCount</strong>
        </div>

        <div class="yatco-stat-card">
            <span>Total Accounts</span>
            <strong>@Model.Count</strong>
        </div>
    </section>

    <section class="yatco-social-guide">
        <div>
            <p class="yatco-eyebrow">Before Scheduling</p>
            <h2>Connect Facebook first</h2>
            <p>
                A scheduled post needs a connected social account before it can publish.
                Use the Facebook connection button before generating and scheduling posts from the Listings page.
            </p>
        </div>

        <div class="yatco-social-guide-actions">
            <a asp-controller="FacebookOAuth"
               asp-action="Connect"
               class="btn yatco-primary-button">
                Connect Facebook Page
            </a>

            <a asp-controller="Listings"
               asp-action="Index"
               class="btn yatco-secondary-button">
                Go to Listings
            </a>
        </div>
    </section>

    @if (!Model.Any())
    {
        <section class="yatco-empty-schedule">
            <p class="yatco-eyebrow">No Accounts Connected</p>
            <h2>No social accounts are connected yet.</h2>
            <p>
                Connect a Facebook Page to give the sandbox a real destination for scheduled Facebook posts.
            </p>

            <a asp-controller="FacebookOAuth"
               asp-action="Connect"
               class="btn yatco-connect-button yatco-connect-button-large">
                Connect Facebook Page
            </a>
        </section>
    }
    else
    {
        <section class="yatco-social-account-grid">
            @foreach (var account in Model)
            {
                var statusClass = account.IsConnected ? "connected" : "disconnected";
                var statusText = account.IsConnected ? "Connected" : "Disconnected";

                <article class="yatco-social-account-card">
                    <div class="yatco-social-account-topline">
                        <span class="yatco-social-platform">@account.Platform</span>
                        <span class="yatco-social-status yatco-social-status-@statusClass">
                            @statusText
                        </span>
                    </div>

                    <h2>@account.DisplayName</h2>

                    <div class="yatco-social-account-meta">
                        <div>
                            <span>Platform Account ID</span>
                            <strong>
                                @if (!string.IsNullOrWhiteSpace(account.PlatformAccountId))
                                {
                                    @account.PlatformAccountId
                                }
                                else
                                {
                                    <text>Not available</text>
                                }
                            </strong>
                        </div>

                        <div>
                            <span>Secret Reference</span>
                            <strong>
                                @if (!string.IsNullOrWhiteSpace(account.SecretName))
                                {
                                    @account.SecretName
                                }
                                else
                                {
                                    <text>Not available</text>
                                }
                            </strong>
                        </div>

                        <div>
                            <span>Updated UTC</span>
                            <strong>@account.UpdatedUtc.ToString("u")</strong>
                        </div>
                    </div>
                </article>
            }
        </section>
    }
</div>