<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Listing Auto Poster Sandbox</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ListingAutoPosterSandbox.Web.styles.css" asp-append-version="true" />
</head>
<body class="yatco-app-body">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    }

    <header class="yatco-topbar">
        <nav class="navbar navbar-expand-lg yatco-shell-nav">
            <div class="container-fluid yatco-shell-container">
                <a class="yatco-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="yatco-brand-mark">BOSS</span>
                    <span class="yatco-brand-copy">
                        <strong>Yacht Auto Poster</strong>
                        <small>Sandbox</small>
                    </span>
                </a>

                <button class="navbar-toggler yatco-nav-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#yatcoMainNavigation"
                        aria-controls="yatcoMainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="yatcoMainNavigation" class="collapse navbar-collapse">
                    <ul class="navbar-nav yatco-main-nav me-auto">
                        <li class="nav-item">
                            <a class="yatco-nav-link @(currentController == "Home" ? "is-active" : "")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="yatco-nav-link @(currentController == "Listings" ? "is-active" : "")"
                               asp-area=""
                               asp-controller="Listings"
                               asp-action="Index">
                                Listings
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="yatco-nav-link @(currentController == "SocialAccounts" || currentController == "FacebookOAuth" ? "is-active" : "")"
                               asp-area=""
                               asp-controller="SocialAccounts"
                               asp-action="Index">
                                Social Accounts
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="yatco-nav-link @(currentController == "ScheduledPosts" ? "is-active" : "")"
                               asp-area=""
                               asp-controller="ScheduledPosts"
                               asp-action="Index">
                                Scheduled Posts
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="yatco-nav-link" href="/hangfire">
                                Hangfire
                            </a>
                        </li>
                    </ul>

                    <div class="yatco-nav-actions">
                        <a asp-controller="FacebookOAuth"
                           asp-action="Connect"
                           class="btn yatco-connect-button">
                            Connect Facebook Page
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="yatco-main-content">
        @RenderBody()
    </main>

    <footer class="yatco-footer">
        <div class="container-fluid yatco-shell-container">
            <span>&copy; 2026 - Listing Auto Poster Sandbox</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>