@using ListingAutoPosterSandbox.Web.Models
@model List<ListingAutoPosterSandbox.Web.Models.ScheduledPost>

@{
    ViewData["Title"] = "Scheduled Posts";
    var easternTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");

    var scheduledCount = Model.Count(post => post.Status == PostStatus.Scheduled);
    var postedCount = Model.Count(post => post.Status == PostStatus.Posted);
    var failedCount = Model.Count(post => post.Status == PostStatus.Failed);
}

<div class="yatco-page-shell">
    <section class="yatco-page-header">
        <div>
            <p class="yatco-eyebrow">Publishing Queue</p>
            <h1>Scheduled Posts</h1>
            <p>
                Review upcoming posts, manually publish pending posts, and inspect platform results.
            </p>
        </div>

        <a asp-controller="Listings" asp-action="Index" class="btn yatco-secondary-button">
            Back to Listings
        </a>
    </section>

    <section class="yatco-stats-grid">
        <div class="yatco-stat-card">
            <span>Scheduled</span>
            <strong>@scheduledCount</strong>
        </div>

        <div class="yatco-stat-card">
            <span>Posted</span>
            <strong>@postedCount</strong>
        </div>

        <div class="yatco-stat-card">
            <span>Failed</span>
            <strong>@failedCount</strong>
        </div>

        <div class="yatco-stat-card">
            <span>Total</span>
            <strong>@Model.Count</strong>
        </div>
    </section>

    @if (!Model.Any())
    {
        <section class="yatco-empty-schedule">
            <p class="yatco-eyebrow">No Posts Yet</p>
            <h2>No scheduled posts have been created.</h2>
            <p>
                Generate a caption from the Listings page, select connected accounts, and schedule the first post.
            </p>

            <a asp-controller="Listings" asp-action="Index" class="btn yatco-primary-button">
                Go to Listings
            </a>
        </section>
    }
    else
    {
        <section class="yatco-post-list">
            @foreach (var post in Model)
            {
                var easternScheduledTime = TimeZoneInfo.ConvertTimeFromUtc(post.ScheduledUtc, easternTimeZone);
                var statusClass = post.Status.ToString().ToLowerInvariant();

                <article class="yatco-post-card">
                    <div class="yatco-post-card-main">
                        <div class="yatco-post-topline">
                            <span class="yatco-status-badge yatco-status-@statusClass">
                                @post.Status
                            </span>

                            <span class="yatco-post-platform">
                                @post.Platform
                            </span>
                        </div>

                        <h2>@(post.Listing?.Title ?? "Unknown listing")</h2>

                        <div class="yatco-post-meta-grid">
                            <div>
                                <span>Social Account</span>
                                <strong>
                                    @if (post.SocialAccount is not null)
                                    {
                                        @post.SocialAccount.DisplayName
                                    }
                                    else
                                    {
                                        <text>None</text>
                                    }
                                </strong>
                            </div>

                            <div>
                                <span>Scheduled Time</span>
                                <strong>@easternScheduledTime.ToString("MMM d, yyyy h:mm tt") Eastern</strong>
                                <small>UTC: @post.ScheduledUtc.ToString("yyyy-MM-dd HH:mm")</small>
                            </div>

                            <div>
                                <span>Attempts</span>
                                <strong>@post.AttemptCount</strong>
                            </div>

                            <div>
                                <span>External Post ID</span>
                                <strong>
                                    @if (!string.IsNullOrWhiteSpace(post.ExternalPostId))
                                    {
                                        @post.ExternalPostId
                                    }
                                    else
                                    {
                                        <text>None</text>
                                    }
                                </strong>
                            </div>
                        </div>

                        <p class="yatco-post-caption">
                            @post.Caption
                        </p>

                        @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                        {
                            <div class="yatco-post-image-url">
                                <strong>Image URL:</strong> @post.ImageUrl
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(post.LastError))
                        {
                            <div class="yatco-alert yatco-alert-error">
                                <strong>Last error:</strong> @post.LastError
                            </div>
                        }
                    </div>

                    <div class="yatco-post-actions">
                        @if (post.Status == PostStatus.Scheduled || post.Status == PostStatus.Failed)
                        {
                            <form asp-controller="ScheduledPosts"
                                  asp-action="PublishNow"
                                  asp-route-id="@post.Id"
                                  method="post"
                                  class="yatco-inline-form">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn yatco-primary-button">
                                    Publish Now
                                </button>
                            </form>
                        }
                        
                        <a asp-controller="ScheduledPosts"
                           asp-action="Details"
                           asp-route-id="@post.Id"
                           class="btn yatco-secondary-button">
                            Details
                        </a>

                        @if (post.Status == PostStatus.Scheduled || post.Status == PostStatus.Failed)
                        {
                            <a asp-controller="ScheduledPosts"
                               asp-action="Edit"
                               asp-route-id="@post.Id"
                               class="btn yatco-secondary-button">
                                Edit
                            </a>

                            <form asp-controller="ScheduledPosts"
                                  asp-action="Cancel"
                                  asp-route-id="@post.Id"
                                  method="post"
                                  class="yatco-inline-form"
                                  onsubmit="return confirm('Cancel this post?');">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn yatco-danger-button">
                                    Cancel
                                </button>
                            </form>
                        }

                        @if (post.Status == PostStatus.Failed || post.Status == PostStatus.Cancelled)
                        {
                            <form asp-controller="ScheduledPosts"
                                  asp-action="Remove"
                                  asp-route-id="@post.Id"
                                  method="post"
                                  class="yatco-inline-form"
                                  onsubmit="return confirm('Remove this post from the sandbox queue? This will also remove its publish attempts.');">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn yatco-danger-button">
                                    Remove
                                </button>
                            </form>
                        }

                        @if (post.Status == PostStatus.Posted)
                        {
                            <span class="yatco-published-label">
                                Published
                            </span>
                        }

                        @if (post.Status == PostStatus.Cancelled)
                        {
                            <span class="yatco-published-label">
                                Cancelled
                            </span>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>