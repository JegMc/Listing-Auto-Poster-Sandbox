@using ListingAutoPosterSandbox.Web.Models
@model ListingAutoPosterSandbox.Web.ViewModels.GeneratedCaptionViewModel

@{
    ViewData["Title"] = "Generated Caption";
    var defaultScheduleTime = DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm");
    var location = string.IsNullOrWhiteSpace(Model.Listing.Location)
        ? Model.Listing.Address
        : Model.Listing.Location;
}

<div class="container mt-4">
    <h1>Generated Caption</h1>

    <div class="mb-4">
        <h4>@Model.Listing.Title</h4>

        @if (!string.IsNullOrWhiteSpace(location))
        {
            <p class="mb-1">@location</p>
        }

        <p class="fw-semibold mb-2">
            @(Model.Listing.Price > 0 ? Model.Listing.Price.ToString("C0") : "Price on request")
        </p>

        <p>@Model.Listing.Description</p>
    </div>

    <form asp-controller="ScheduledPosts" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="ListingId" value="@Model.Listing.Id" />

        <div class="mb-3">
            <label class="form-label" for="Caption">Caption</label>
            <textarea class="form-control"
                      id="Caption"
                      name="Caption"
                      rows="8"
                      required>@Model.Caption</textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Social Accounts</label>

            @if (Model.SocialAccounts.Any())
            {
                <div class="border rounded p-3">
                    @foreach (var account in Model.SocialAccounts)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                type="checkbox"
                                name="SocialAccountIds"
                                value="@account.Id"
                                id="social-account-@account.Id"
                                checked="@(account.Platform.ToString().Equals("Facebook", StringComparison.OrdinalIgnoreCase))" />

                            <label class="form-check-label" for="social-account-@account.Id">
                                @account.Platform - @account.DisplayName
                            </label>
                        </div>
                    }
                </div>

                <div class="form-text">
                    Select one or more connected social accounts. Each selected account creates its own scheduled post.
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    No connected social accounts are available. Connect a social account before scheduling a post.
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label" for="ScheduledLocal">Schedule Time</label>
            <input class="form-control"
                   id="ScheduledLocal"
                   name="ScheduledLocal"
                   type="datetime-local"
                   value="@defaultScheduleTime"
                   required />
        </div>

        <button type="submit" class="btn btn-primary" @(Model.SocialAccounts.Any() ? "" : "disabled")>
            Schedule Post
        </button>

        <a asp-controller="Listings" asp-action="Index" class="btn btn-secondary">
            Back to Listings
        </a>
    </form>
</div>