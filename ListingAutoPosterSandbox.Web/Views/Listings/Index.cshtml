@model List<ListingAutoPosterSandbox.Web.Models.Listing>

@{
    ViewData["Title"] = "Listings";
}

<div class="yatco-page-shell">
    <section class="yatco-page-header">
        <div>
            <p class="yatco-eyebrow">Yacht Inventory</p>
            <h1>Listings</h1>
            <p>
                Select a yacht listing or create a custom yacht post. The next step generates a caption,
                lets you choose connected social accounts, and schedules the post.
            </p>
        </div>

        <a asp-controller="ScheduledPosts" asp-action="Index" class="btn yatco-secondary-button">
            View Scheduled Posts
        </a>
    </section>

    @if (TempData["Success"] is string success)
    {
        <div class="yatco-alert yatco-alert-success">
            @success
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="yatco-alert yatco-alert-error">
            @error
        </div>
    }

    <section class="yatco-custom-card">
        <div class="yatco-custom-card-header">
            <div>
                <p class="yatco-eyebrow">Custom Input</p>
                <h2>Custom Yacht Post</h2>
                <p>
                    Enter yacht, brokerage, buyer, seller, or marketing notes. The AI will convert them into
                    yacht-focused social media copy.
                </p>
            </div>
        </div>

        <form asp-controller="Listings" asp-action="GenerateCustomCaption" method="post" enctype="multipart/form-data" class="yatco-custom-form">
            @Html.AntiForgeryToken()

            <div class="yatco-form-group yatco-form-group-wide">
                <label for="CustomDetails" class="yatco-form-label">Custom Information</label>
                <textarea id="CustomDetails"
                          name="CustomDetails"
                          class="form-control yatco-caption-box"
                          rows="5"
                          placeholder="Example: 2021 Sunseeker 88 Yacht in Miami, strong charter appeal, 4 cabins, modern interior, ideal for Bahamas cruising."></textarea>
                <p class="yatco-helper-text">
                    This can be structured data, rough notes, or a plain English request.
                </p>
            </div>

            <div class="yatco-custom-fields">
                <div class="yatco-form-group">
                    <label for="Title" class="yatco-form-label">Yacht / Listing Title</label>
                    <input id="Title" name="Title" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group">
                    <label for="Builder" class="yatco-form-label">Builder</label>
                    <input id="Builder" name="Builder" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group">
                    <label for="BrokerageCompany" class="yatco-form-label">Company / Brokerage</label>
                    <input id="BrokerageCompany" name="BrokerageCompany" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group">
                    <label for="Location" class="yatco-form-label">Location</label>
                    <input id="Location" name="Location" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group">
                    <label for="LengthFeet" class="yatco-form-label">Length</label>
                    <div class="yatco-input-with-unit">
                        <input id="LengthFeet" name="LengthFeet" type="number" step="0.1" class="form-control yatco-input" />
                        <span>ft</span>
                    </div>
                </div>

                <div class="yatco-form-group">
                    <label for="YearBuilt" class="yatco-form-label">Year Built</label>
                    <input id="YearBuilt" name="YearBuilt" type="number" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group">
                    <label for="Cabins" class="yatco-form-label">Cabins</label>
                    <input id="Cabins" name="Cabins" type="number" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group">
                    <label for="Guests" class="yatco-form-label">Guests</label>
                    <input id="Guests" name="Guests" type="number" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group">
                    <label for="MaxSpeedKnots" class="yatco-form-label">Max Speed</label>
                    <div class="yatco-input-with-unit">
                        <input id="MaxSpeedKnots" name="MaxSpeedKnots" type="number" step="0.1" class="form-control yatco-input" />
                        <span>kn</span>
                    </div>
                </div>

                <div class="yatco-form-group">
                    <label for="Price" class="yatco-form-label">Price</label>
                    <input id="Price" name="Price" type="number" step="1" class="form-control yatco-input" />
                </div>

                <div class="yatco-form-group yatco-form-group-wide">
                    <label for="ImageUrl" class="yatco-form-label">Image URL</label>
                    <input id="ImageUrl" name="ImageUrl" class="form-control yatco-input" />
                </div>
                <div class="yatco-form-group yatco-form-group-wide">
                    <label for="HeroImageFile" class="yatco-form-label">Upload Hero Image</label>
                    <input id="HeroImageFile"
                        name="HeroImageFile"
                        type="file"
                        accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                        class="form-control yatco-input" />
                    <p class="yatco-helper-text">
                        Optional. Use either a public image URL or upload a local JPG, PNG, or WebP hero image.
                        Uploaded images are stored locally for sandbox testing.
                    </p>
                </div>
            </div>

            <div class="yatco-action-row">
                <button type="submit" class="btn yatco-primary-button">
                    Generate Custom Scheduled Post
                </button>
            </div>
        </form>
    </section>

    <section class="yatco-listing-section">
        <div class="yatco-section-heading">
            <div>
                <p class="yatco-eyebrow">Sample Listings</p>
                <h2>Choose a Yacht</h2>
            </div>
        </div>

        @if (Model is null || !Model.Any())
        {
            <div class="yatco-empty-state">
                No listings were found.
            </div>
        }
        else
        {
            <div class="yatco-listing-grid">
                @foreach (var listing in Model)
                {
                    var location = string.IsNullOrWhiteSpace(listing.Location)
                        ? listing.Address
                        : listing.Location;

                    var imageUrl = string.IsNullOrWhiteSpace(listing.ImageUrl)
                        ? "https://placehold.co/900x600?text=Yacht+Listing"
                        : listing.ImageUrl;

                    <article class="yatco-yacht-card">
                        <div class="yatco-yacht-image-wrap">
                            <img src="@imageUrl" alt="@listing.Title" class="yatco-yacht-image" />
                            <span class="yatco-yacht-price">
                                @(listing.Price > 0 ? listing.Price.ToString("C0") : "Price on request")
                            </span>
                        </div>

                        <div class="yatco-yacht-body">
                            <p class="yatco-eyebrow">Yacht Listing</p>
                            <h3>@listing.Title</h3>

                            @if (!string.IsNullOrWhiteSpace(location))
                            {
                                <p class="yatco-yacht-location">@location</p>
                            }

                            <div class="yatco-yacht-specs">
                                @if (!string.IsNullOrWhiteSpace(listing.Builder))
                                {
                                    <span>Builder: @listing.Builder</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(listing.BrokerageCompany))
                                {
                                    <span>Company: @listing.BrokerageCompany</span>
                                }

                                @if (listing.LengthFeet.HasValue)
                                {
                                    <span>@listing.LengthFeet.Value.ToString("0.#") ft</span>
                                }

                                @if (listing.YearBuilt.HasValue)
                                {
                                    <span>Year: @listing.YearBuilt</span>
                                }

                                @if (listing.Cabins.HasValue)
                                {
                                    <span>Cabins: @listing.Cabins</span>
                                }

                                @if (listing.Guests.HasValue)
                                {
                                    <span>Guests: @listing.Guests</span>
                                }

                                @if (listing.MaxSpeedKnots.HasValue)
                                {
                                    <span>Max: @listing.MaxSpeedKnots.Value.ToString("0.#") kn</span>
                                }
                            </div>

                            <p class="yatco-yacht-description">
                                @listing.Description
                            </p>

                            <div class="yatco-card-actions">
                                <a asp-controller="Listings"
                                   asp-action="GenerateCaption"
                                   asp-route-id="@listing.Id"
                                   class="btn yatco-primary-button">
                                    Generate Generic Scheduled Post
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>